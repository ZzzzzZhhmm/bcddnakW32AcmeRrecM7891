{
  "schema": "warm.preprocessing.v1",
  "adapter": "piper_teleop",
  "dataset_id": "piper_single_arm_v1",
  "output": "../../real/piper/processed/session_v1",
  "source": {
    "root": "../../real/piper/raw",
    "manifest": "piper_episodes.template.json",
    "allow_synthetic": false,
    "calibration_id": "UNCONFIRMED_CALIBRATION",
    "control_frame": "UNCONFIRMED_BASE_FRAME",
    "tcp_frame": "UNCONFIRMED_TCP_FRAME",
    "timestamp_tolerance_s": 0.005,
    "include_outcomes": [
      "success"
    ]
  },
  "profile": {
    "action_dim": 7,
    "state_dim": 7,
    "fps": 20,
    "action_horizon": 32,
    "action_video_freq_ratio": 4,
    "camera_keys": [
      "external",
      "wrist"
    ],
    "semantic_camera": "external",
    "image_layout": "horizontal_224",
    "gripper_action_indices": [
      6
    ],
    "gripper_state_indices": [
      6
    ],
    "delta_action_mask": [
      true,
      true,
      true,
      true,
      true,
      true,
      false
    ],
    "normalization": "min/max",
    "control_mode": "base_delta_tcp_rotvec_plus_absolute_gripper_width_m",
    "embodiment": "piper_single_active_6dof"
  },
  "encoders": {
    "dino_checkpoint": "../../checkpoints/dinov2-base",
    "dino_model_id": "facebook/dinov2-base",
    "dino_revision": "UNCONFIRMED_PINNED_COMMIT",
    "vae_checkpoint": "../../checkpoints/Wan2.2_VAE.pth",
    "include_vae": true,
    "device": "cuda",
    "dtype": "bfloat16",
    "dino_batch_size": 16,
    "vae_batch_size": 4
  },
  "memory": {
    "start_mode": "hybrid",
    "top_k": 32,
    "mining": {
      "gripper_change_threshold": 0.001
    }
  },
  "test_only": false
}
